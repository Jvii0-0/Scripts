local function collectRelevantProperties(instance)
    local properties = {}
    local seen = {}

    for _, group in ipairs(PROPERTY_GROUPS) do
        for _, propertyName in ipairs(group) do
            if not seen[propertyName] then
                seen[propertyName] = true

                -- Name/ClassName/path are already represented at the record level.
                if propertyName ~= "Name" and propertyName ~= "ClassName" and propertyName ~= "Parent" then
                    local ok, propertyValue = pcall(function()
                        return instance[propertyName]
                    end)

                    if ok and propertyValue ~= nil then
                        local valueOK, safeValue = pcall(function()
                            return safeJSONValue(propertyValue)
                        end)

                        if valueOK then
                            properties[propertyName] = {
                                dataType = typeof(propertyValue),
                                value = safeValue
                            }
                        end
                    end
                end
            end
        end
    end

    return properties
end

local function buildJSONAsync(updateStatus, selectedOnly, exportOptions)

    exportOptions = exportOptions or {}
    local includeChildren = exportOptions.includeChildren ~= false
    local includeAttributes = exportOptions.includeAttributes ~= false
    local includeProperties = exportOptions.includeProperties ~= false
    local includeTags = exportOptions.includeTags ~= false
    local includeEmptyProperties = exportOptions.includeEmptyProperties == true
    local searchText = string.lower(tostring(exportOptions.searchText or ""))

    local roots = {}

    if selectedOnly and scanned[selectedOnly] then
        table.insert(roots, selectedOnly)
    else
        -- The scan contains every descendant, so only export scanned roots here.
        -- Each root is then traversed recursively exactly once.
        for instance in pairs(scanned) do
            local parentIsScanned = false
            pcall(function()
                local parent = instance.Parent
                parentIsScanned = parent ~= nil and scanned[parent] == true
            end)

            if not parentIsScanned then
                table.insert(roots, instance)
            end
        end
    end

    table.sort(roots, function(a, b)
        local pathA, pathB = "", ""
        pcall(function() pathA = getPath(a) end)
        pcall(function() pathB = getPath(b) end)
        return pathA < pathB
    end)

    -- Optional instance search. A match is checked against name, class, and path.
    -- This filters the export roots without changing the recursive hierarchy.
    if searchText ~= "" then
        local filteredRoots = {}
        for _, instance in ipairs(roots) do
            local name, className, path = "", "", ""
            pcall(function() name = tostring(instance.Name) end)
            pcall(function() className = tostring(instance.ClassName) end)
            pcall(function() path = tostring(getPath(instance)) end)
            local haystack = string.lower(name .. " " .. className .. " " .. path)
            if string.find(haystack, searchText, 1, true) then
                table.insert(filteredRoots, instance)
            end
        end
        roots = filteredRoots
    end

    local stats = {
        totalInstances = 0,
        totalAttributes = 0,
        totalProperties = 0,
        totalTags = 0,
        totalReferences = 0,
        maxDepth = 0,
        exportedRoots = #roots,
        failedInstances = 0,
        errors = {}
    }

    local nextExportId = 0

    local progressTotal = instanceCount
    if selectedOnly and scanned[selectedOnly] then
        progressTotal = 1
        pcall(function()
            progressTotal += #selectedOnly:GetDescendants()
        end)
    end
    if searchText ~= "" then
        progressTotal = math.max(1, #roots)
    end

    local function safePath(instance)
        local path = "<unavailable>"
        pcall(function() path = getPath(instance) end)
        return path
    end

    local function getServiceName(instance)
        local serviceName = nil
        pcall(function()
            local top = instance
            while top and top.Parent and top.Parent ~= game do
                top = top.Parent
            end
            if top and top.Parent == game then
                serviceName = top.Name
            end
        end)
        return serviceName
    end

    local function getTransform(instance)
        local transform = nil
        local className = ""
        pcall(function() className = instance.ClassName end)

        if className == "BasePart" or className == "Part" or className == "MeshPart" or className == "UnionOperation" then
            local ok, cf = pcall(function() return instance.CFrame end)
            if ok and cf then
                transform = {
                    type = "CFrame",
                    value = safeJSONValue(cf)
                }
            end
        elseif className == "Model" then
            local ok, cf = pcall(function() return instance:GetPivot() end)
            if ok and cf then
                transform = {
                    type = "Pivot",
                    value = safeJSONValue(cf)
                }
            end
        elseif className == "Attachment" then
            local ok, cf = pcall(function() return instance.WorldCFrame end)
            if ok and cf then
                transform = {
                    type = "WorldCFrame",
                    value = safeJSONValue(cf)
                }
            end
        elseif className == "Camera" then
            local ok, cf = pcall(function() return instance.CFrame end)
            if ok and cf then
                transform = {
                    type = "CFrame",
                    value = safeJSONValue(cf)
                }
            end
        end

        return transform
    end

    local function collectTags(instance)
        local tags = {}
        local ok, result = pcall(function()
            return CollectionService:GetTags(instance)
        end)
        if ok and type(result) == "table" then
            for _, tag in ipairs(result) do
                table.insert(tags, tostring(tag))
            end
            table.sort(tags)
        end
        return tags
    end

    local function buildInstanceRecord(instance, depth, childIndex, parentPath)
        if jsonCancelRequested then
            return nil, "Export cancelled."
        end

        nextExportId += 1
        local exportId = nextExportId
        local path = safePath(instance)
        local className = "<unknown>"
        local name = "<unknown>"
        pcall(function() className = instance.ClassName end)
        pcall(function() name = instance.Name end)

        local record = {
            exportId = exportId,
            name = name,
            className = className,
            path = path,
            parentPath = parentPath,
            service = getServiceName(instance),
            depth = depth,
            childIndex = childIndex,
            childrenCount = 0,
            descendantCount = 0,
            attributesCount = 0,
            attributes = {},
            tagsCount = 0,
            tags = {},
            properties = {},
            transform = getTransform(instance),
            references = {},
            children = {},
            errors = {}
        }

        stats.totalInstances += 1
        if depth > stats.maxDepth then
            stats.maxDepth = depth
        end

        -- Attributes
        if includeAttributes then
        local attrOK, attrData = pcall(function()
            return getAttributes(instance)
        end)

        if attrOK and type(attrData) == "table" then
            for attributeName, attributeValue in pairs(attrData) do
                local valueOK, safeValue = pcall(function()
                    return safeJSONValue(attributeValue)
                end)

                if valueOK then
                    record.attributes[tostring(attributeName)] = {
                        dataType = typeof(attributeValue),
                        value = safeValue
                    }
                    record.attributesCount += 1
                    stats.totalAttributes += 1

                    if typeof(attributeValue) == "Instance" then
                        table.insert(record.references, {
                            source = "attribute",
                            name = tostring(attributeName),
                            target = safeValue
                        })
                    end
                else
                    record.attributes[tostring(attributeName)] = {
                        dataType = typeof(attributeValue),
                        type = "error",
                        value = tostring(safeValue)
                    }
                    table.insert(record.errors, "Attribute serialization failed: " .. tostring(attributeName))
                end
            end
        elseif not attrOK then
            table.insert(record.errors, "GetAttributes failed: " .. tostring(attrData))
        end
        end

        -- CollectionService tags
        if includeTags then
        record.tags = collectTags(instance)
        record.tagsCount = #record.tags
        stats.totalTags += record.tagsCount
        end

        -- Class-aware properties
        if includeProperties then
        local propertiesOK, propertiesOrError = pcall(function()
            return collectRelevantProperties(instance)
        end)

        if propertiesOK and type(propertiesOrError) == "table" then
            record.properties = propertiesOrError
            for propertyName, propertyRecord in pairs(record.properties) do
                stats.totalProperties += 1
                if type(propertyRecord) == "table" and propertyRecord.dataType == "Instance" then
                    table.insert(record.references, {
                        source = "property",
                        name = tostring(propertyName),
                        target = propertyRecord.value
                    })
                end
            end
        else
            table.insert(record.errors, "Property collection failed: " .. tostring(propertiesOrError))
        end
        end

        if includeProperties and not includeEmptyProperties then
            for propertyName, propertyRecord in pairs(record.properties) do
                if propertyRecord == nil or (type(propertyRecord) == "table" and propertyRecord.value == nil and propertyRecord.error == nil) then
                    record.properties[propertyName] = nil
                end
            end
        end

        record.referencesCount = #record.references
        stats.totalReferences += record.referencesCount

        -- Recursive hierarchy
        local childrenOK
        local childList
        if includeChildren then
        childrenOK, childList = pcall(function()
            return instance:GetChildren()
        end)

        if childrenOK and type(childList) == "table" then
            record.childrenCount = #childList
            for index, child in ipairs(childList) do
                if jsonCancelRequested then
                    return nil, "Export cancelled."
                end

                local childRecord, childError = buildInstanceRecord(
                    child,
                    depth + 1,
                    index,
                    path
                )

                if childRecord then
                    table.insert(record.children, childRecord)
                elseif childError then
                    return nil, childError
                end

                if nextExportId % JSON_BATCH_SIZE == 0 then
                    task.wait()
                end
            end
        elseif not childrenOK then
            table.insert(record.errors, "GetChildren failed: " .. tostring(childList))
        end
        end

        -- Compute descendant count from the recursive records we actually exported.
        local descendantCount = 0
        for _, childRecord in ipairs(record.children) do
            descendantCount += 1 + (tonumber(childRecord.descendantCount) or 0)
        end
        record.descendantCount = descendantCount

        if #record.errors > 0 then
            stats.failedInstances += 1
            table.insert(stats.errors, {
                exportId = exportId,
                path = path,
                errors = record.errors
            })
        end

        if updateStatus then
            updateStatus(nextExportId, math.max(1, progressTotal), stats.failedInstances)
        end

        return record
    end

    -- Reuse the existing property collector defined above this function.
    -- If it is unexpectedly unavailable, export continues with an empty property table.
    local allRecords = {}

    for rootIndex, root in ipairs(roots) do
        if jsonCancelRequested then
            return nil, "Export cancelled."
        end

        local record, errorMessage = buildInstanceRecord(root, 0, rootIndex, "game")
        if record then
            table.insert(allRecords, record)
        elseif errorMessage then
            return nil, errorMessage
        end
    end

    -- The Complete Export schema is an object so metadata and integrity data
    -- can travel with the hierarchy without breaking the instance records.
    local exportData = {
        metadata = {
            format = "RobloxClientInspector.CompleteExport",
            version = 3,
            options = {
                includeChildren = includeChildren,
                includeAttributes = includeAttributes,
                includeProperties = includeProperties,
                includeTags = includeTags,
                includeEmptyProperties = includeEmptyProperties,
                searchText = exportOptions.searchText or ""
            },
            generatedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            selectedOnly = selectedOnly ~= nil and scanned[selectedOnly] == true,
            rootCount = #allRecords,
            rootPaths = {}
        },
        statistics = stats,
        integrity = {
            ok = #stats.errors == 0,
            errorCount = #stats.errors,
            checkedInstances = stats.totalInstances
        },
        instances = allRecords
    }

    for _, record in ipairs(allRecords) do
        table.insert(exportData.metadata.rootPaths, record.path)
    end

    local ok, finalJSON = pcall(function()
        return HttpService:JSONEncode(exportData)
    end)

    if not ok then
        return nil, "Final JSON encoding failed: " .. tostring(finalJSON)
    end

    return finalJSON, {
        total = stats.totalInstances,
        failed = stats.failedInstances,
        attributes = stats.totalAttributes,
        properties = stats.totalProperties,
        tags = stats.totalTags,
        references = stats.totalReferences,
        maxDepth = stats.maxDepth
    }
end

