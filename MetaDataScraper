local function scanInstance(instance, generation)
    if scanGeneration ~= generation or instanceCount >= MAX_INSTANCES or scanned[instance] then return end

    scanned[instance] = true
    instanceCount += 1

    local attrs = getAttributes(instance)
    local attrCount = 0
    for _ in pairs(attrs) do attrCount += 1 end
    local tags = getInstanceTags(instance)

    local parent = instance.Parent
    local depth = 0
    if parent == game then
        depth = 1
    elseif parent then
        local parentMeta = instanceMeta[parent]
        depth = parentMeta and ((parentMeta.depth or 0) + 1) or 1
    end

    instanceMeta[instance] = {
        lowerName = string.lower(instance.Name),
        lowerClass = string.lower(instance.ClassName),
        attributes = attrs,
        attributeCount = attrCount,
        tags = tags,
        tagCount = #tags,
        depth = depth,
        childCount = 0,
        descendantCount = 0,
        path = nil,
        pathParent = nil,
        pathParentPath = nil,
        pathName = instance.Name,
        lowerAttributes = nil,
        lowerTags = nil,
    }
    attributeCount += attrCount

    if instanceCount % YIELD_EVERY == 0 then
        setMainStatus("Scanning... " .. tostring(instanceCount) .. " instances", "working")
        task.wait()
    end

    local children = {}
    if not pcall(function() children = instance:GetChildren() end) then return end
    for _, child in ipairs(children) do
        if scanGeneration ~= generation or instanceCount >= MAX_INSTANCES then return end
        scanInstance(child, generation)
    end

    local meta = instanceMeta[instance]
    meta.childCount = #children
    local descendantCount = 0
    for _, child in ipairs(children) do
        local childMeta = instanceMeta[child]
        if childMeta then
            descendantCount += 1 + (childMeta.descendantCount or 0)
        end
    end
    meta.descendantCount = descendantCount
end

local function performScan()
    if scanInProgress then return end
    scanInProgress = true
    scanGeneration += 1
    local generation = scanGeneration
    scanned = {}
    instanceMeta = {}
    instanceCount = 0
    attributeCount = 0
    selectedInstance = nil
    expanded = {[game] = true}
    searchCache = {}
    searchCacheQuery = nil
    setMainStatus("Scanning...", "working")
    task.spawn(function()
        scanInstance(game, generation)
        if scanGeneration ~= generation then return end
        scanInProgress = false
        local limited = instanceCount >= MAX_INSTANCES
        setMainStatus(limited and ("Scan complete — limit " .. tostring(MAX_INSTANCES) .. " reached") or ("Scan complete — " .. tostring(instanceCount) .. " instances"), limited and "warning" or "success", 1)
        rebuildTree()
        showDetails(nil)
    end)
end

