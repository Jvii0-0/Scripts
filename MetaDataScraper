local function getAttributeCount(instance)
local count = 0

local success, attributes = pcall(function()
return instance:GetAttributes()
end)

if success and attributes then
for _ in pairs(attributes) do
count += 1
end
end

return count
end

------------------------------------------------------------

local function getAttributes(instance)
local success, attributes = pcall(function()
return instance:GetAttributes()
end)

if success then
return attributes
end

return {}
end

------------------------------------------------------------
-- SEARCH
------------------------------------------------------------

local function instanceMatches(instance)
if classFilter ~= "" and string.lower(instance.ClassName) ~= string.lower(classFilter) then
return false
end

if currentSearch == "" then
return true
end

local search = string.lower(currentSearch)

if string.find(string.lower(instance.Name), search, 1, true) then
return true
end

if string.find(string.lower(instance.ClassName), search, 1, true) then
return true
end

local attributes = getAttributes(instance)

for name, value in pairs(attributes) do
if string.find(string.lower(tostring(name)), search, 1, true) then
return true
end

if string.find(string.lower(tostring(value)), search, 1, true) then
return true
end
end

return false
end

------------------------------------------------------------

local function hasMatchingDescendant(instance)
for _, descendant in ipairs(instance:GetDescendants()) do
if instanceMatches(descendant) then
return true
end
end

return false
end

