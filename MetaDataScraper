local function expandAll()
for instance in pairs(scanned) do
local children = {}

pcall(function()
children = instance:GetChildren()
end)

if #children > 0 then
expanded[instance] = true
end
end

rebuildTree()
end

------------------------------------------------------------

local function collapseAll()
expanded = {}

rebuildTree()
end

------------------------------------------------------------
-- LIVE DETECTION
------------------------------------------------------------

local function disconnectWatchers()
for _, connection in ipairs(connections) do
pcall(function()
connection:Disconnect()
end)
end

connections = {}
end

------------------------------------------------------------

local function startWatching()
disconnectWatchers()

local connection = game.DescendantAdded:Connect(function(instance)
if not scanned[instance] then
task.spawn(function()
local before = instanceCount

scanInstance(instance, scanGeneration)

if instanceCount ~= before then
statusLabel.Text =
"Instances: "
.. tostring(instanceCount)
.. " | Attributes: "
.. tostring(attributeCount)

rebuildTree()
end
end)
end
end)

table.insert(connections, connection)
end

