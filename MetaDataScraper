------------------------------------------------------------
-- SCANNING
------------------------------------------------------------

local function scanInstance(instance, generation)
if scanGeneration ~= generation then
return
end

if instanceCount >= MAX_INSTANCES then
return
end

if scanned[instance] then
return
end

scanned[instance] = true
instanceCount += 1

local attrs = getAttributes(instance)

for _ in pairs(attrs) do
attributeCount += 1
end

if instanceCount % YIELD_EVERY == 0 then
statusLabel.Text =
"Scanning... "
.. tostring(instanceCount)
.. " instances"

task.wait()
end

local children = {}

local success = pcall(function()
children = instance:GetChildren()
end)

if not success then
return
end

for _, child in ipairs(children) do
if scanGeneration ~= generation then
return
end

if instanceCount >= MAX_INSTANCES then
