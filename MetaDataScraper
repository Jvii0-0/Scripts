local function updateMobileLayout()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local w,h = viewport.X, viewport.Y
    local compact = w <= 760
    local phone = w <= 600

    mainFrame.Size = UDim2.fromScale(phone and 0.94 or 0.92, phone and 0.90 or 0.86)
    mainFrame.Position = UDim2.fromScale(0.5,0.5)
    mainFrame.AnchorPoint = Vector2.new(0.5,0.5)

    titleBar.Size = UDim2.new(1,0,0, phone and 48 or 50)
    titleLabel.Position = UDim2.fromOffset(14,6)
    titleLabel.Size = UDim2.new(compact and 0.40 or 0.44,0,0,22)
    titleLabel.TextSize = phone and 14 or 17
    subtitleLabel.Position = UDim2.fromOffset(14,27)
    subtitleLabel.TextSize = phone and 8 or 9
    closeButton.Size = UDim2.fromOffset(phone and 30 or 34,30)
    closeButton.Position = UDim2.new(1, -(phone and 36 or 39), 0, 8)

    -- Give the primary search field most of the remaining title-bar width so
    -- long queries/placeholders stay inside the field instead of colliding with
    -- the title or close button.
    searchBox.Size = UDim2.new(0.50, phone and -42 or (compact and -46 or -52), 0, phone and 30 or 34)
    searchBox.Position = UDim2.new(0.48, 0, 0, phone and 9 or 8)
    searchBox.TextSize = phone and 10 or 12
    searchBox.TextTruncate = Enum.TextTruncate.AtEnd

    -- Keep the action toolbar to ONE row at every viewport size.
    -- On smaller screens buttons become compact/abbreviated instead of wrapping,
    -- which preserves vertical space for the Explorer and Details panels.
    local top = phone and 56 or 58
    local toolbarHeight = 38
    toolbar.Size = UDim2.new(1,-20,0,toolbarHeight)
    toolbar.Position = UDim2.fromOffset(10,top)

    local buttons={rescanButton,expandButton,collapseButton,jsonButton,filterButton}
    local desktopLabels={"Rescan","Expand All","Collapse All","JSON","Class"}
    local compactLabels={"Scan","Expand","Collapse","JSON","Class"}
    local phoneLabels={"Scan","Exp","Col","JSON","Class"}
    local gap = phone and 2 or (compact and 4 or 6)
    local availableWidth = math.max(300, mainFrame.AbsoluteSize.X - 20)
    local minButton = phone and 26 or (compact and 48 or 34)
    local totalGap = gap * (#buttons - 1)
    local bw = math.floor((availableWidth - totalGap) / #buttons)
    bw = math.max(minButton, bw)

    -- If the viewport is extremely narrow, allow the toolbar itself to scroll
    -- horizontally, but NEVER create a second row.
    toolbar.ClipsDescendants = true

    local labels = phone and phoneLabels or (compact and compactLabels or desktopLabels)
    for i,b in ipairs(buttons) do
        b.Size=UDim2.fromOffset(bw,30)
        b.Position=UDim2.fromOffset((i-1)*(bw+gap),1)
        b.Text=labels[i]
        b.TextSize=phone and 8 or (compact and 9 or 11)
        b.TextTruncate=Enum.TextTruncate.AtEnd
    end

    -- The toolbar has no status text now; persistent operation feedback lives in
    -- the dedicated status bar at the bottom of the Inspector.
    statusLabel.Visible=false

    local contentTop=top+toolbarHeight+8
    local footerH=34
    if phone then
        local frameH = mainFrame.AbsoluteSize.Y
        local available = math.max(260, frameH - contentTop - footerH - 10)
        local panelGap = 8
        local panelH = math.max(110, math.floor((available - panelGap) / 2))
        treeFrame.Size=UDim2.new(1,-20,0,panelH)
        treeFrame.Position=UDim2.fromOffset(10,contentTop)
        detailsFrame.Size=UDim2.new(1,-20,0,panelH)
        detailsFrame.Position=UDim2.fromOffset(10,contentTop + panelH + panelGap)
    else
        treeFrame.Size=UDim2.new(0.52,-15,1,-contentTop-footerH-8)
        treeFrame.Position=UDim2.fromOffset(10,contentTop)
        detailsFrame.Size=UDim2.new(0.48,-15,1,-contentTop-footerH-8)
        detailsFrame.Position=UDim2.new(0.52,5,0,contentTop)
    end
    statusBar.Size=UDim2.new(1,-20,0,28)
    statusBar.Position=UDim2.new(0,10,1,-34)
    refreshStatusCounts()
end

updateMobileLayout()

if workspace.CurrentCamera then
