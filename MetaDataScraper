local function updateMobileLayout()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local isMobile = viewport.X <= 600

    if isMobile then
        mainFrame.Size = UDim2.new(0.94, 0, 0.88, 0)
        mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)

        titleLabel.Size = UDim2.new(0.40, 0, 1, 0)
        titleLabel.TextSize = 15
        searchBox.Size = UDim2.new(0.28, 0, 0, 30)
        searchBox.Position = UDim2.new(0.47, 0, 0, 6)
        searchBox.TextSize = 12

        toolbar.Size = UDim2.new(1, -20, 0, 70)
        statusLabel.Visible = false

        treeFrame.Size = UDim2.new(1, -20, 0.43, 0)
        treeFrame.Position = UDim2.new(0, 10, 0, 95)

        detailsFrame.Size = UDim2.new(1, -20, 0.43, 0)
        detailsFrame.Position = UDim2.new(0, 10, 0.51, 0)
    else
        mainFrame.Size = UDim2.new(0.94, 0, 0.88, 0)
        mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)

        titleLabel.Size = UDim2.new(0.42, 0, 1, 0)
        titleLabel.TextSize = 18
        searchBox.Size = UDim2.new(0.32, 0, 0, 32)
        searchBox.Position = UDim2.new(0.54, 0, 0, 5)
        searchBox.TextSize = 14

        toolbar.Size = UDim2.new(1, -20, 0, 40)
        statusLabel.Visible = true

        treeFrame.Size = UDim2.new(0.52, -15, 1, -105)
        treeFrame.Position = UDim2.fromOffset(10, 95)

        detailsFrame.Size = UDim2.new(0.48, -15, 1, -105)
        detailsFrame.Position = UDim2.new(0.52, 5, 0, 95)
    end
end

updateMobileLayout()

if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateMobileLayout)
end

