local function showJSON()

    if jsonGenerating then
        return
    end

    jsonCancelRequested = false
    fullJSON = ""
    jsonRecordCount = 0
    jsonGenerating = false

    -- Capture the current selection when the export starts.
    local exportSelection = selectedInstance
    local exportingSelected = exportSelection ~= nil and scanned[exportSelection] == true
    

    --====================================================
    -- WINDOW
    --====================================================

    local jsonGui = Instance.new("Frame")

    jsonGui.Name = "JSONExportWindow"

    -- Keep the JSON window inside the current screen.
    -- Delta can run on mobile/small viewports where a fixed 750x500
    -- window would extend beyond the visible area.
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)

