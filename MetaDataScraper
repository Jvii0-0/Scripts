                "Still Generating"

            return
        end

        discordButton.Text =
            "Uploading..."

        discordButton.Active = false

        task.spawn(function()

            local timestamp =
                os.date("%Y-%m-%d_%H-%M-%S")

            local exportPrefix = exportingSelected and "roblox_selected_export_" or "roblox_export_"

            local fileName =
                exportPrefix ..
                timestamp ..
                ".json"

            -- IMPORTANT:
            -- Uses the global jsonRecordCount.
            -- No out-of-scope snapshot variable.
            local success, message =
                uploadJSONToDiscord(
                    fullJSON,
                    fileName,
                    jsonRecordCount
                )

            if success then

                discordButton.Text =
                    "Uploaded!"

                statusLabel.Text =
                    message

            else

                discordButton.Text =
                    "Upload Failed"

                statusLabel.Text =
                    tostring(message)

            end

            task.delay(2, function()

                if discordButton.Parent then

                    discordButton.Text =
                        "Upload to Discord"

                    discordButton.Active = true

                end

            end)

        end)

    end)

    --====================================================
    -- CANCEL
    --====================================================

    local cancelButton =
        Instance.new("TextButton")

    cancelButton.Size =
        UDim2.new(0, 100, 0, 35)

    cancelButton.Position =
        UDim2.new(1, -115, 1, -45)

    cancelButton.BackgroundColor3 =
        Color3.fromRGB(130, 70, 50)

    cancelButton.Text = "Cancel"

    cancelButton.TextColor3 =
        Color3.new(1, 1, 1)

    cancelButton.TextSize = 14

    cancelButton.Font =
        Enum.Font.SourceSansBold

    cancelButton.ZIndex = 102
    cancelButton.Parent = jsonGui

    cancelButton.MouseButton1Click:Connect(function()

        jsonCancelRequested = true

        statusLabel.Text =
            "Cancelling..."

        cancelButton.Active = false

    end)

    --====================================================
    -- START GENERATION
    --====================================================

    task.spawn(function()

        local result, info =
            buildJSONAsync(function(
                processed,
                total,
                failed
            )

                if not jsonGui.Parent then
                    jsonCancelRequested = true
                    return
                end

                recordLabel.Text =
                    "Records: " ..
                    tostring(processed) ..
                    " / " ..
                    tostring(total)

                if failed > 0 then

                    statusLabel.Text =
                        "Generating... " ..
                        tostring(processed) ..
                        " / " ..
                        tostring(total) ..
                        " | Errors: " ..
                        tostring(failed)

                else

                    statusLabel.Text =
                        "Generating... " ..
                        tostring(processed) ..
                        " / " ..
                        tostring(total)

                end

            end, exportingSelected and exportSelection or nil)

        jsonGenerating = false

        --================================================
        -- FAILED / CANCELLED
        --================================================

        if not result then

            if jsonGui.Parent then

                statusLabel.Text =
                    tostring(info)

                previewBox.Text =
                    tostring(info)

            end

            return
        end

        --================================================
        -- STORE COMPLETE JSON
        --================================================

        fullJSON = result

        jsonRecordCount =
            info.total or 0

        --================================================
        -- PREVIEW FIRST 25 RECORDS
        --================================================

        local previewEntries = {}

        local decodeOK, decoded =
            pcall(function()
                return HttpService:JSONDecode(result)
            end)

        if decodeOK and type(decoded) == "table" then

            for i = 1,
                math.min(
                    #decoded,
                    JSON_PREVIEW_RECORDS
                ) do

                local encodeOK, preview =
                    pcall(function()

                        return HttpService:JSONEncode(
                            decoded[i]
                        )

                    end)

                if encodeOK then
                    table.insert(
                        previewEntries,
                        preview
                    )
                end

            end
        end

        previewBox.Text =
            "[" ..
            table.concat(
                previewEntries,
                ",\n"
            ) ..
            "]"

        --================================================
        -- FINAL SIZE
        --================================================

        local byteSize =
            #fullJSON

        local sizeKB =
            byteSize / 1024

        recordLabel.Text =
            "Records: " ..
            tostring(jsonRecordCount)

        sizeLabel.Text =
            string.format(
                "JSON Size: %.2f KB",
                sizeKB
            )

        if info.failed and info.failed > 0 then

            statusLabel.Text =
                (exportingSelected and "Selected export complete — " or "Export complete — ") ..
                tostring(info.failed) ..
                " record(s) had export errors."

        else

            statusLabel.Text =
                exportingSelected and "Selected JSON generated successfully — ready to upload."
                or "JSON generated successfully — ready to upload."

        end

    end)
end


-- EXPAND / COLLAPSE
------------------------------------------------------------

local function expandAll()
for instance in pairs(scanned) do
local children = {}

pcall(function()
children = instance:GetChildren()
end)

if #children > 0 then
expanded[instance] = true
end
end

rebuildTree()
end

------------------------------------------------------------

local function collapseAll()
expanded = {}

rebuildTree()
end

------------------------------------------------------------
-- LIVE DETECTION
------------------------------------------------------------

local function disconnectWatchers()
for _, connection in ipairs(connections) do
pcall(function()
connection:Disconnect()
end)
end

connections = {}
end

------------------------------------------------------------

local function startWatching()
disconnectWatchers()

local connection = game.DescendantAdded:Connect(function(instance)
if not scanned[instance] then
task.spawn(function()
local before = instanceCount

scanInstance(instance, scanGeneration)

if instanceCount ~= before then
statusLabel.Text =
"Instances: "
.. tostring(instanceCount)
.. " | Attributes: "
.. tostring(attributeCount)

rebuildTree()
end
end)
end
end)

table.insert(connections, connection)
end

