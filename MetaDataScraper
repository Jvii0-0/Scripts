------------------------------------------------------------
-- LIVE DETECTION
------------------------------------------------------------

local function disconnectWatchers()
for _, connection in ipairs(connections) do
pcall(function()
connection:Disconnect()
end)
end

connections = {}
end

------------------------------------------------------------

local function startWatching()
    disconnectWatchers()

    local pendingLiveRefresh = false

    local function scheduleLiveRefresh()
        if pendingLiveRefresh then return end
        pendingLiveRefresh = true
        task.delay(0.15, function()
            pendingLiveRefresh = false
            if screenGui.Parent then
                requestTreeRefresh()
            end
        end)
    end

    local connection = game.DescendantAdded:Connect(function(instance)
        if scanned[instance] then
            return
        end
        task.spawn(function()
            local before = instanceCount
            scanInstance(instance, scanGeneration)
            if instanceCount ~= before then
                local addedMeta = instanceMeta[instance]
                local addedSubtree = addedMeta and (1 + (addedMeta.descendantCount or 0)) or 1
                local parent = instance.Parent
                while parent and parent ~= game do
                    local parentMeta = instanceMeta[parent]
                    if not parentMeta then break end
                    parentMeta.descendantCount = (parentMeta.descendantCount or 0) + addedSubtree
                    parent = parent.Parent
                end
                statusLabel.Text = "Instances: " .. tostring(instanceCount) .. " | Attributes: " .. tostring(attributeCount)
                searchCacheQuery = nil
                scheduleLiveRefresh()
            end
        end)
    end)

    table.insert(connections, connection)
end

