        local depth=0; local cur=inst
        while cur and cur~=game do depth+=1; cur=cur.Parent end
        if depth>maxDepth then maxDepth=depth end
    end

    row("SCAN",27,true); row("Instances:  "..tostring(instanceCount)); row("Attributes:  "..tostring(totalAttrs)); row("Tags:  "..tostring(totalTags)); row("Maximum hierarchy depth:  "..tostring(maxDepth))
