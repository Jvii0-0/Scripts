-- ============================================================
-- JSON EXPORT
-- ============================================================

local JSON_BATCH_SIZE = 25
local exportCancelled = false
local jsonGui = nil

-- Convert values into guaranteed JSON-safe values.
local function safeJSONValue(value, depth)
	depth = depth or 0

	-- Prevent pathological/circular tables
	if depth > 10 then
		return {
			type = "table",
			value = "<max depth reached>"
		}
	end

	local valueType = typeof(value)

	if valueType == "nil"
		or valueType == "string"
		or valueType == "boolean" then
		return value
	end

	if valueType == "number" then
		-- JSON cannot represent NaN / infinity
		if value ~= value or value == math.huge or value == -math.huge then
			return {
				type = "number",
				value = tostring(value)
			}
		end

		return value
	end

	if valueType == "Vector3" then
		return {
			type = "Vector3",
			X = value.X,
			Y = value.Y,
			Z = value.Z
		}

	elseif valueType == "Vector2" then
		return {
			type = "Vector2",
			X = value.X,
			Y = value.Y
		}

	elseif valueType == "Color3" then
		return {
			type = "Color3",
			R = value.R,
			G = value.G,
			B = value.B
		}

	elseif valueType == "CFrame" then
		local components = {value:GetComponents()}

		return {
			type = "CFrame",
			components = components
		}

	elseif valueType == "UDim2" then
		return {
			type = "UDim2",
			X = {
				Scale = value.X.Scale,
				Offset = value.X.Offset
			},
			Y = {
				Scale = value.Y.Scale,
				Offset = value.Y.Offset
			}
		}

	elseif valueType == "UDim" then
		return {
			type = "UDim",
			Scale = value.Scale,
			Offset = value.Offset
		}

	elseif valueType == "BrickColor" then
		return {
			type = "BrickColor",
			Name = value.Name,
			Number = value.Number
		}

	elseif valueType == "EnumItem" then
		return {
			type = "EnumItem",
			enum = tostring(value.EnumType),
			name = value.Name,
			value = value.Value
		}

	elseif valueType == "Instance" then
		return {
			type = "Instance",
			name = value.Name,
			className = value.ClassName,
			path = getPath(value)
		}

	elseif valueType == "table" then
		local result = {}

		for key, item in pairs(value) do
			local safeKey

			if typeof(key) == "string" then
				safeKey = key
			else
				safeKey = tostring(key)
			end

			local success, converted = pcall(function()
				return safeJSONValue(item, depth + 1)
			end)

			if success then
				result[safeKey] = converted
			else
				result[safeKey] = {
					type = "error",
					value = tostring(converted)
				}
			end
		end

		return result
	end

	-- Final fallback:
	-- NEVER give an unsupported Roblox datatype directly to JSONEncode.
	return {
		type = valueType,
		value = tostring(value)
	}
end


local function buildJSONAsync(updateStatus)
	local snapshot = {}

	-- Snapshot scanned Instances first so the live watcher cannot
	-- modify the table while we're exporting.
	for instance in pairs(scanned) do
		table.insert(snapshot, instance)
	end

	local total = #snapshot
	local encodedEntries = {}

	for i, instance in ipairs(snapshot) do
		if exportCancelled then
			return nil, "Export cancelled."
		end

		local entrySuccess, entryResult = pcall(function()

			local attributes = {}

			-- Get attributes safely
			local attrSuccess, attrResult = pcall(function()
				return getAttributes(instance)
			end)

			if attrSuccess and type(attrResult) == "table" then
				for attributeName, attributeValue in pairs(attrResult) do
					local valueSuccess, safeValue = pcall(function()
						return safeJSONValue(attributeValue)
					end)

					if valueSuccess then
						attributes[attributeName] = safeValue
					else
						attributes[attributeName] = {
							type = "error",
							value = tostring(safeValue)
						}
					end
				end
			end

			local path = "<unknown>"

			pcall(function()
				path = getPath(instance)
			end)

			local entry = {
				name = instance.Name,
				className = instance.ClassName,
				path = path,
				attributes = attributes
			}

			return HttpService:JSONEncode(entry)
		end)

		if entrySuccess then
			table.insert(encodedEntries, entryResult)
		else
			-- Keep the export alive even if one Instance fails.
			local errorEntry = {
				name = "<export error>",
				className = "Unknown",
				path = "<unknown>",
				attributes = {},
				exportError = tostring(entryResult)
			}

			local fallbackSuccess, fallbackJSON = pcall(function()
				return HttpService:JSONEncode(errorEntry)
			end)

			if fallbackSuccess then
				table.insert(encodedEntries, fallbackJSON)
			end
		end

		-- Update progress frequently.
		if i % JSON_BATCH_SIZE == 0 or i == total then
			if updateStatus then
				updateStatus(i, total)
			end

			-- Give Roblox time to render/respond.
			task.wait()
		end
	end

	if exportCancelled then
		return nil, "Export cancelled."
	end

	return "[" .. table.concat(encodedEntries, ",") .. "]"
end


