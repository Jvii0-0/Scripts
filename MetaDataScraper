local function showDetails(instance)
    selectedInstance = instance

    clearDetails()

    if not instance then
        addDetail("Select an Instance to view its information.", 45)
        return
    end

    local attributes = getAttributes(instance)

    addDetail("Name: " .. instance.Name)
    addDetail("Class: " .. instance.ClassName)
    addDetail("Path: " .. getPath(instance), 45)

    local children = 0

    pcall(function()
        children = #instance:GetChildren()
    end)

    addDetail("Children: " .. tostring(children))
    addDetail("Attributes: " .. tostring(getAttributeCount(instance)))

    if next(attributes) then
        addDetail("ATTRIBUTE VALUES", 30)

        for name, value in pairs(attributes) do
            local valueText = tostring(value)

            local text =
                tostring(name)
                .. " = "
                .. valueText
                .. "  ["
                .. typeof(value)
                .. "]"

            addDetail(text, 42)
        end
    else
        addDetail("No attributes.", 35)
    end
end

