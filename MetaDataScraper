local function selectSearchMatch(direction)
    refreshSearchCache()
    local matches = {}
    for inst, matched in pairs(searchCache) do if matched then table.insert(matches, inst) end end
    table.sort(matches, function(a,b) return getPath(a) < getPath(b) end)
    if #matches == 0 then return end
    local index = 1
    for i, inst in ipairs(matches) do if inst == selectedInstance then index = i; break end end
    index = ((index - 1 + direction) % #matches) + 1
    local target = matches[index]
    local parent = target.Parent
    while parent and parent ~= game do expanded[parent] = true; parent = parent.Parent end
    expanded[game] = true
    selectedInstance = target
    rebuildTree()
    task.defer(function()
        local targetIndex = nil
        for i, node in ipairs(treeVisibleNodes) do
            if node[1] == target then
                targetIndex = i
                break
            end
        end
        if targetIndex then
            local y = (targetIndex - 1) * TREE_ROW_HEIGHT - 12
            local maxY = math.max(0, treeContentHeight - treeScroll.AbsoluteWindowSize.Y)
            treeScroll.CanvasPosition = Vector2.new(0, math.clamp(y, 0, maxY))
        end
    end)
    showDetails(target)
    setMainStatus("Match " .. tostring(index) .. " / " .. tostring(#matches), "ready")
end

