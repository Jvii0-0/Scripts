local function getAttributeCount(instance)
    local meta = instanceMeta[instance]
    if meta and meta.attributeCount ~= nil then
        return meta.attributeCount
    end

    local count = 0
    local success, attributes = pcall(function() return instance:GetAttributes() end)
    if success and attributes then
        for _ in pairs(attributes) do count += 1 end
    end
    return count
end

------------------------------------------------------------

local function getAttributes(instance)
    local meta = instanceMeta[instance]
    if meta and meta.attributes then
        return meta.attributes
    end

    local success, attributes = pcall(function() return instance:GetAttributes() end)
    if success and attributes then
        if meta then
            meta.attributes = attributes
            local count = 0
            for _ in pairs(attributes) do count += 1 end
            meta.attributeCount = count
        end
        return attributes
    end
    return {}
end

------------------------------------------------------------
-- SEARCH
------------------------------------------------------------

local function getInstanceTags(instance)
    local meta = instanceMeta[instance]
    if meta and meta.tags then
        return meta.tags
    end
    local tags = {}
    pcall(function() tags = CollectionService:GetTags(instance) end)
    if meta then
        meta.tags = tags
        meta.tagCount = #tags
    end
    return tags
end

local function parseSearchQuery(text)
    local filters = {free = {}}
    for token in string.gmatch(string.lower(text or ""), "[^%s]+") do
        local key, value = token:match("^(name|class|path|attr|attribute|tag):(.+)$")
        if key and value then
            if key == "attribute" then key = "attr" end
            filters[key] = filters[key] or {}
            table.insert(filters[key], value)
        elseif token ~= "" then
            table.insert(filters.free, token)
        end
    end
    return filters
end

local function instanceMatches(instance, queryText, filters)
    queryText = queryText or currentSearch
    if classFilter ~= "" and string.lower(instance.ClassName) ~= string.lower(classFilter) then
        return false
    end
    if queryText == "" then return true end

    local f = filters or searchFilters or parseSearchQuery(queryText)
    local meta = instanceMeta[instance]
    local name = meta and meta.lowerName or string.lower(instance.Name)
    local className = meta and meta.lowerClass or string.lower(instance.ClassName)
    local path = nil
    local attributes = meta and meta.attributes or getAttributes(instance)
    local tags = meta and meta.tags or getInstanceTags(instance)
    local lowerAttributes = meta and meta.lowerAttributes
    local lowerTags = meta and meta.lowerTags
    if meta and not lowerAttributes then
        lowerAttributes = {}
        for k, v in pairs(attributes) do
            table.insert(lowerAttributes, string.lower(tostring(k)))
            table.insert(lowerAttributes, string.lower(tostring(v)))
        end
        meta.lowerAttributes = lowerAttributes
    end
    if meta and not lowerTags then
        lowerTags = {}
        for _, tag in ipairs(tags) do
            table.insert(lowerTags, string.lower(tostring(tag)))
        end
        meta.lowerTags = lowerTags
    end

    local function getLowerPath()
        if path == nil then path = string.lower(getPath(instance)) end
        return path
    end
    local function contains(list, needle)
        for _, v in ipairs(list or {}) do
            if string.find(v, needle, 1, true) then return true end
        end
        return false
    end

    for _, needle in ipairs(f.name or {}) do if not string.find(name, needle, 1, true) then return false end end
    for _, needle in ipairs(f.class or {}) do if not string.find(className, needle, 1, true) then return false end end
    for _, needle in ipairs(f.path or {}) do if not string.find(getLowerPath(), needle, 1, true) then return false end end
    for _, needle in ipairs(f.attr or {}) do
        local found = false
        for _, value in ipairs(lowerAttributes or {}) do
            if string.find(value, needle, 1, true) then found = true break end
        end
        if not found then return false end
    end
    for _, needle in ipairs(f.tag or {}) do
        local found = false
        for _, tag in ipairs(lowerTags or {}) do
            if string.find(tag, needle, 1, true) then found = true break end
        end
        if not found then return false end
    end

    for _, needle in ipairs(f.free or {}) do
        local found = string.find(name, needle, 1, true) or string.find(className, needle, 1, true)
        if not found and (f.path and #f.path > 0) then found = string.find(getLowerPath(), needle, 1, true) end
        if not found then
            -- Free-text searches retain path matching without computing paths for
            -- name/class-only queries that already matched.
            found = string.find(getLowerPath(), needle, 1, true)
        end
        if not found then
            for _, value in ipairs(lowerAttributes or {}) do
                if string.find(value, needle, 1, true) then found = true break end
            end
        end
        if not found then
            for _, tag in ipairs(lowerTags or {}) do
                if string.find(tag, needle, 1, true) then found = true break end
            end
        end
        if not found then return false end
    end
    return true
end

local function refreshSearchCache()
    local cacheKey = currentSearch .. "|" .. classFilter
    if searchCacheQuery == cacheKey then return end
    searchCache = {}
    searchFilters = parseSearchQuery(currentSearch)
    searchCacheQuery = cacheKey

    for inst in pairs(scanned) do
        searchCache[inst] = instanceMatches(inst, currentSearch, searchFilters)
    end

    -- Propagate direct matches to ancestors instead of calling GetDescendants()
    -- for every visible tree node. Each matching instance walks only its parent chain.
    for inst, matched in pairs(searchCache) do
        if matched then
            local parent = inst.Parent
            while parent and parent ~= game do
                if not scanned[parent] then break end
                if searchCache[parent] then break end
                searchCache[parent] = true
                parent = parent.Parent
            end
            if scanned[game] then searchCache[game] = true end
        end
    end
end

local function hasMatchingDescendant(instance)
    return searchCache[instance] == true
end

