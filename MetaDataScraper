	-- GENERATE IN BACKGROUND
	-- ========================================================

	task.spawn(function()

		local success, result, errorMessage = pcall(function()

			local json, err = buildJSONAsync(function(current, total)
				if status and status.Parent then
					status.Text = string.format(
						"Generating JSON... %d / %d",
						current,
						total
					)
				end
			end)

			if not json then
				return nil, err
			end

			return json, nil
		end)

		if not success then
			if status and status.Parent then
				status.Text = "Export failed."
			end

			if textBox and textBox.Parent then
				textBox.Text = "EXPORT FAILED:\n\n" .. tostring(result)
			end

			return
		end

		if not result then
			if status and status.Parent then
				status.Text = "Export cancelled."
			end

			if textBox and textBox.Parent then
				textBox.Text = "EXPORT CANCELLED."
			end

			return
		end

		-- Window may have been closed while exporting.
		if not jsonGui or not jsonGui.Parent then
			return
		end

		status.Text = "JSON generated successfully."

		textBox.Text = result

		-- Put cursor at beginning.
		pcall(function()
			textBox.CursorPosition = 1
			textBox.SelectionStart = 1
		end)
	end)
