local function ensureTreeRowPool()
    local needed = getTreeRowCount()
    while #treeRowPool < needed do
        createTreeRow()
    end
end

local function buildVisibleTreeNodes()
    local nodes = {}
    local count = 0
    local stack = {{game, 0, 1, false}}

    while #stack > 0 and count < MAX_VISIBLE_TREE_NODES do
        local item = table.remove(stack)
        local instance, depth, childIndex, duplicateName = item[1], item[2], item[3], item[4]
        if currentSearch == "" or instanceMatches(instance, currentSearch, searchFilters) or hasMatchingDescendant(instance) then
            count += 1
            nodes[count] = {instance, depth, childIndex, duplicateName}

            if expanded[instance] then
                local children = {}
                pcall(function() children = instance:GetChildren() end)
                local nameCounts = {}
                for _, child in ipairs(children) do
                    nameCounts[child.Name] = (nameCounts[child.Name] or 0) + 1
                end
                for i = #children, 1, -1 do
                    local child = children[i]
                    if currentSearch == "" or instanceMatches(child, currentSearch, searchFilters) or hasMatchingDescendant(child) then
                        table.insert(stack, {child, depth + 1, i, nameCounts[child.Name] > 1})
                    end
                end
            end
        end
    end
    return nodes, count
end

local function renderVirtualTree()
    ensureTreeRowPool()
    local nodes, count = buildVisibleTreeNodes()
    treeVisibleNodes = nodes
    treeNodeCount = count
    treeContentHeight = count * TREE_ROW_HEIGHT + 16
    treeScroll.CanvasSize = UDim2.fromOffset(0, treeContentHeight)

    for i, row in ipairs(treeRowPool) do
        local node = nodes[i]
        if node then
            styleTreeRow(row, node[1], node[2], node[3], node[4], i)
        else
            row.Visible = false
            treeRowInstances[row] = nil
        end
    end

    local oldY = treeScroll.CanvasPosition.Y
    local maxY = math.max(0, treeContentHeight - treeScroll.AbsoluteWindowSize.Y)
    treeScroll.CanvasPosition = Vector2.new(0, math.clamp(oldY, 0, maxY))
    if count >= MAX_VISIBLE_TREE_NODES then
        setMainStatus("Display limited to " .. tostring(MAX_VISIBLE_TREE_NODES) .. " visible nodes", "warning")
    end
end

function rebuildTree()
    refreshSearchCache()
    if expanded[game] == nil then expanded[game] = true end
    renderVirtualTree()
end

requestTreeRefresh = function()
    if treeRefreshQueued then return end
    treeRefreshQueued = true
    task.defer(function()
        treeRefreshQueued = false
        if screenGui.Parent then rebuildTree() end
    end)
end

treeScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
    -- Render only rows intersecting the viewport.
    if treeRefreshQueued then return end
    local first = math.floor(treeScroll.CanvasPosition.Y / TREE_ROW_HEIGHT) + 1
    local last = first + #treeRowPool - 1
    for i = first, last do
        local node = treeVisibleNodes[i]
        local row = treeRowPool[i - first + 1]
        if row then
            if node then
                styleTreeRow(row, node[1], node[2], node[3], node[4], i)
            else
                row.Visible = false
                treeRowInstances[row] = nil
            end
        end
    end
end)

