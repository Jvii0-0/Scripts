end

-- Track recent selections without duplicating entries.
for i = #recentInstances, 1, -1 do
if recentInstances[i] == instance then table.remove(recentInstances, i) end
end
table.insert(recentInstances, 1, instance)
while #recentInstances > 8 do table.remove(recentInstances) end

