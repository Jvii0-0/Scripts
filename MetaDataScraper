local function formatDisplayValue(value)
    local valueType = typeof(value)
    if value == nil then return "nil" end
    if valueType == "string" then return string.format("%q", value) end
    if valueType == "number" then return string.format("%.6g", value) end
    if valueType == "boolean" then return tostring(value) end
    if valueType == "Vector3" then return string.format("(%.3f, %.3f, %.3f)", value.X, value.Y, value.Z) end
    if valueType == "Vector2" then return string.format("(%.3f, %.3f)", value.X, value.Y) end
    if valueType == "Color3" then return string.format("RGB(%d, %d, %d)", math.floor(value.R*255+0.5), math.floor(value.G*255+0.5), math.floor(value.B*255+0.5)) end
    if valueType == "CFrame" then local p=value.Position; return string.format("CFrame(%.2f, %.2f, %.2f)",p.X,p.Y,p.Z) end
    if valueType == "UDim2" then return string.format("{%s,%d},{%s,%d}",tostring(value.X.Scale),value.X.Offset,tostring(value.Y.Scale),value.Y.Offset) end
    if valueType == "UDim" then return string.format("{%s,%d}",tostring(value.Scale),value.Offset) end
    if valueType == "BrickColor" then return value.Name .. " (#" .. tostring(value.Number) .. ")" end
    if valueType == "EnumItem" then return tostring(value.EnumType) .. "." .. value.Name end
    if valueType == "Instance" then return value.Name .. " <" .. value.ClassName .. ">" end
    return tostring(value)
end

