local function createNode(instance, depth)
    if currentSearch ~= "" then
        if not instanceMatches(instance)
            and not hasMatchingDescendant(instance) then
            return
        end
    end

    local children = {}

    pcall(function()
        children = instance:GetChildren()
    end)

    local hasChildren = #children > 0
    local isExpanded = expanded[instance] == true

    local button = Instance.new("TextButton")

    button.Name = "Node"
    button.Size = UDim2.new(1, -5, 0, 27)

    button.BackgroundColor3 =
        selectedInstance == instance
        and Color3.fromRGB(55, 55, 55)
        or Color3.fromRGB(25, 25, 25)

    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(225, 225, 225)

    button.TextSize = 13
    button.Font = Enum.Font.Gotham

    button.TextXAlignment = Enum.TextXAlignment.Left
    button.AutoButtonColor = true

    button.ZIndex = 13
    button.Parent = treeScroll

    local arrow = ""

    if hasChildren then
        arrow = isExpanded and "▼ " or "▶ "
    else
        arrow = "   "
    end

    local attributeNumber = getAttributeCount(instance)

    local attributeText = ""

    if attributeNumber > 0 then
        attributeText = "  [" .. tostring(attributeNumber) .. " attr]"
    end

    button.Text =
        string.rep("    ", depth)
        .. arrow
        .. instance.Name
        .. "  <"
        .. instance.ClassName
        .. ">"
        .. attributeText

    button.MouseButton1Click:Connect(function()
        showDetails(instance)

        if hasChildren then
            expanded[instance] = not expanded[instance]
            rebuildTree()
        else
            rebuildTree()
        end
    end)

    if isExpanded then
        for _, child in ipairs(children) do
            createNode(child, depth + 1)
        end
    end
end

