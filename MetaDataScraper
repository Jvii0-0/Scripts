        warning = Color3.fromRGB(245, 190, 80),
        error = Color3.fromRGB(245, 100, 100)
    }
    local c = colors[kind or "ready"] or colors.ready
    statusDot.TextColor3 = c
    if progress ~= nil then
        local n = math.clamp(tonumber(progress) or 0, 0, 1)
        progressTrack.Visible = n > 0 and n < 1
        progressFill.Size = UDim2.new(n, 0, 1, 0)
    else
        progressTrack.Visible = false
    end
end

local toastSerial = 0
local function showToast(message, kind, duration)
    toastSerial += 1
    local serial = toastSerial
    local old = screenGui:FindFirstChild("InspectorToast")
    if old then old:Destroy() end
    local toast = Instance.new("Frame")
    toast.Name = "InspectorToast"
    toast.Size = UDim2.new(0, math.min(360, math.max(220, (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X or 600) * 0.36)), 0, 42)
    toast.Position = UDim2.new(1, -18, 1, -18)
    toast.AnchorPoint = Vector2.new(1, 1)
    toast.BackgroundColor3 = THEME.panel2
    toast.BorderSizePixel = 0
    toast.ZIndex = 50000
    toast.Parent = screenGui
    round(toast, 8)
    stroke(toast, THEME.stroke, 0.1, 1)
    local dot = Instance.new("TextLabel")
    dot.Size = UDim2.fromOffset(28, 42)
    dot.BackgroundTransparency = 1
    dot.Text = kind == "error" and "✕" or (kind == "warning" and "⚠" or (kind == "working" and "◐" or "✓"))
    dot.TextColor3 = (kind == "error" and Color3.fromRGB(245,100,100)) or (kind == "warning" and Color3.fromRGB(245,190,80)) or (kind == "working" and Color3.fromRGB(100,170,255)) or Color3.fromRGB(100,230,150)
    dot.TextSize = 14
    dot.Font = Enum.Font.GothamBold
    dot.ZIndex = 50001
    dot.Parent = toast
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -38, 1, 0)
    label.Position = UDim2.fromOffset(32, 0)
    label.BackgroundTransparency = 1
    label.Text = tostring(message)
    label.TextColor3 = THEME.text
