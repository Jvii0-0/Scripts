local function getPath(instance)
    if instance == game then return "game" end

    local meta = instanceMeta[instance]
    local parent = instance.Parent
    local parentPath = parent and getPath(parent) or "nil"
    if meta and meta.path and meta.pathParent == parent and meta.pathName == instance.Name and meta.pathParentPath == parentPath then
        return meta.path
    end

    local path = (parentPath == "game" and ("game." .. instance.Name)) or (parentPath .. "." .. instance.Name)

    if meta then
        meta.path = path
        meta.pathParent = parent
        meta.pathParentPath = parentPath
        meta.pathName = instance.Name
    end
    return path
end

