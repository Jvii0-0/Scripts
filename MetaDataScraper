--========================================================
-- SAFE JSON VALUE CONVERTER
--========================================================

local function safeJSONValue(value, depth)
    depth = depth or 0

    if depth > 10 then
        return {
            type = "table",
            value = "<maximum depth reached>"
        }
    end

    local valueType = typeof(value)

    if value == nil then
        return nil

    elseif valueType == "string" then
        return value

    elseif valueType == "boolean" then
        return value

    elseif valueType == "number" then
        if value ~= value then
            return "NaN"
        elseif value == math.huge then
            return "Infinity"
        elseif value == -math.huge then
            return "-Infinity"
        end

        return value

    elseif valueType == "Vector3" then
        return {
            type = "Vector3",
            x = value.X,
            y = value.Y,
            z = value.Z
        }

    elseif valueType == "Vector2" then
        return {
            type = "Vector2",
            x = value.X,
            y = value.Y
        }

    elseif valueType == "Color3" then
        return {
            type = "Color3",
            r = value.R,
            g = value.G,
            b = value.B
        }

    elseif valueType == "CFrame" then
        return {
            type = "CFrame",
            components = {value:GetComponents()}
        }

    elseif valueType == "UDim2" then
        return {
            type = "UDim2",
            xScale = value.X.Scale,
            xOffset = value.X.Offset,
            yScale = value.Y.Scale,
            yOffset = value.Y.Offset
        }

    elseif valueType == "UDim" then
        return {
            type = "UDim",
            scale = value.Scale,
            offset = value.Offset
        }

    elseif valueType == "BrickColor" then
        return {
            type = "BrickColor",
            number = value.Number,
            name = value.Name
        }

    elseif valueType == "EnumItem" then
        return {
            type = "EnumItem",
            enumType = tostring(value.EnumType),
            name = value.Name,
            value = value.Value
        }

    elseif valueType == "Instance" then
        local path = "<unavailable>"

        pcall(function()
            path = getPath(value)
        end)

        return {
            type = "Instance",
            name = value.Name,
            className = value.ClassName,
            path = path
        }

    elseif valueType == "table" then
        local result = {}

        for key, item in pairs(value) do
            local safeKey = tostring(key)

            local ok, safeValue = pcall(function()
                return safeJSONValue(item, depth + 1)
            end)

            if ok then
                result[safeKey] = safeValue
            else
                result[safeKey] = {
                    type = "error",
                    value = tostring(safeValue)
                }
            end
        end

        return result

    else
        -- Unknown/non-JSON Roblox values are converted to text
        -- instead of being passed directly to JSONEncode.
        return {
            type = valueType,
            value = tostring(value)
        }
    end
end

