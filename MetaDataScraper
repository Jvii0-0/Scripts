function rebuildTree()
    clearTree()

    createNode(game, 0)

    task.defer(function()
        treeScroll.CanvasPosition = treeScroll.CanvasPosition
    end)
end

------------------------------------------------------------
-- SCANNING
------------------------------------------------------------

local function scanInstance(instance, generation)
    if scanGeneration ~= generation then
        return
    end

    if instanceCount >= MAX_INSTANCES then
        return
    end

    if scanned[instance] then
        return
    end

    scanned[instance] = true
    instanceCount += 1

    local attrs = getAttributes(instance)

    for _ in pairs(attrs) do
        attributeCount += 1
    end

    if instanceCount % YIELD_EVERY == 0 then
        statusLabel.Text =
            "Scanning... "
            .. tostring(instanceCount)
            .. " instances"

        task.wait()
    end

    local children = {}

    local success = pcall(function()
        children = instance:GetChildren()
    end)

    if not success then
        return
    end

    for _, child in ipairs(children) do
        if scanGeneration ~= generation then
            return
        end

        if instanceCount >= MAX_INSTANCES then
            return
        end

        scanInstance(child, generation)
    end
end

------------------------------------------------------------

local function performScan()
    if scanInProgress then
        return
    end

    scanInProgress = true
    scanGeneration += 1

    local generation = scanGeneration

    scanned = {}
    instanceCount = 0
    attributeCount = 0
    selectedInstance = nil

    statusLabel.Text = "Scanning..."

    task.spawn(function()
        scanInstance(game, generation)

        if scanGeneration ~= generation then
            return
        end

        scanInProgress = false

        statusLabel.Text =
            "Instances: "
            .. tostring(instanceCount)
            .. " | Attributes: "
            .. tostring(attributeCount)

        rebuildTree()
        showDetails(nil)
    end)
end

------------------------------------------------------------
-- JSON
------------------------------------------------------------

local function buildJSON()
    local output = {}

    for instance in pairs(scanned) do
        local attributes = {}

        for name, value in pairs(getAttributes(instance)) do
            attributes[name] = serializeValue(value)
        end

        table.insert(output, {
            name = instance.Name,
            className = instance.ClassName,
            path = getPath(instance),
            attributes = attributes
        })
    end

    table.sort(output, function(a, b)
        return a.path < b.path
    end)

    return HttpService:JSONEncode(output)
end

