local function getInstanceTags(instance)
    local tags = {}
    pcall(function() tags = CollectionService:GetTags(instance) end)
    return tags
end

local function parseSearchQuery(text)
    local filters = {free = {}}
    for token in string.gmatch(string.lower(text or ""), "[^%s]+") do
        local key, value = token:match("^(name|class|path|attr|attribute|tag):(.+)$")
        if key and value then
            if key == "attribute" then key = "attr" end
            filters[key] = filters[key] or {}
            table.insert(filters[key], value)
        elseif token ~= "" then
            table.insert(filters.free, token)
        end
    end
    return filters
end

local function instanceMatches(instance, queryText)
    queryText = queryText or currentSearch
    if classFilter ~= "" and string.lower(instance.ClassName) ~= string.lower(classFilter) then
        return false
    end
    if queryText == "" then return true end

    local f = parseSearchQuery(queryText)
    local name = string.lower(instance.Name)
    local className = string.lower(instance.ClassName)
    local path = string.lower(getPath(instance))
    local attributes = getAttributes(instance)
    local tags = getInstanceTags(instance)

    local function contains(list, needle)
        for _, v in ipairs(list or {}) do
            if string.find(v, needle, 1, true) then return true end
        end
        return false
    end

    for _, needle in ipairs(f.name or {}) do if not string.find(name, needle, 1, true) then return false end end
    for _, needle in ipairs(f.class or {}) do if not string.find(className, needle, 1, true) then return false end end
    for _, needle in ipairs(f.path or {}) do if not string.find(path, needle, 1, true) then return false end end
    for _, needle in ipairs(f.attr or {}) do
        local found = false
        for k, v in pairs(attributes) do
            if string.find(string.lower(tostring(k)), needle, 1, true) or string.find(string.lower(tostring(v)), needle, 1, true) then found = true break end
        end
        if not found then return false end
    end
    for _, needle in ipairs(f.tag or {}) do
        local found = false
        for _, tag in ipairs(tags) do if string.find(string.lower(tostring(tag)), needle, 1, true) then found = true break end end
        if not found then return false end
    end

    for _, needle in ipairs(f.free or {}) do
        local found = string.find(name, needle, 1, true) or string.find(className, needle, 1, true) or string.find(path, needle, 1, true)
        if not found then
            for k, v in pairs(attributes) do
                if string.find(string.lower(tostring(k)), needle, 1, true) or string.find(string.lower(tostring(v)), needle, 1, true) then found = true break end
            end
        end
        if not found then
            for _, tag in ipairs(tags) do if string.find(string.lower(tostring(tag)), needle, 1, true) then found = true break end end
        end
        if not found then return false end
    end
    return true
end

local function refreshSearchCache()
    if searchCacheQuery == currentSearch .. "|" .. classFilter then return end
    searchCache = {}
    searchCacheQuery = currentSearch .. "|" .. classFilter
    for inst in pairs(scanned) do
        searchCache[inst] = instanceMatches(inst)
    end
end

local function hasMatchingDescendant(instance)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if searchCache[descendant] then return true end
    end
    return false
end

