local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Constants for colors and sizes
local COLORS = {
    background = Color3.fromRGB(15, 17, 23),
    panel = Color3.fromRGB(25, 28, 38),
    sidebar = Color3.fromRGB(20, 23, 32),
    button = Color3.fromRGB(40, 44, 58),
    buttonHover = Color3.fromRGB(50, 55, 72),
    accent = Color3.fromRGB(100, 150, 255),
    accentDark = Color3.fromRGB(70, 110, 220),
    text = Color3.fromRGB(245, 248, 255),
    muted = Color3.fromRGB(150, 160, 180),
    success = Color3.fromRGB(80, 200, 120),
    danger = Color3.fromRGB(255, 100, 100),
}

local GUI_SIZE = {
    mainWidth = 500,
    mainHeight = 350,
    buttonSize = UDim2.new(0, 32, 0, 32),
    eggButtonSize = UDim2.new(1, 0, 0, 28),
    autoTakeSize = UDim2.new(0, 340, 0, 36),
    toggleSize = UDim2.new(0, 60, 0, 28),
}

-- Helper functions
local function addCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = instance
end

local function createTextLabel(parent, text, size, color, font)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextSize = size
    label.Font = font or Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

local function createButton(parent, text, size, position, bgColor, textColor, font)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = position
    btn.BackgroundColor3 = bgColor
    btn.Text = text
    btn.TextColor3 = textColor
    btn.TextSize = 14
    btn.Font = font or Enum.Font.GothamBold
    btn.AutoButtonColor = false
    addCorner(btn, 6)
    btn.Parent = parent
    return btn
end

-- Load control panel GUI
local function loadControlPanel()
    -- Check if already exists
    local existingGui = playerGui:FindFirstChild("MyControlPanel")
    if existingGui then existingGui:Destroy() end

    -- Create main GUI
    local gui = Instance.new("ScreenGui")
    gui.Name = "MyControlPanel"
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    -- Main window
    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, GUI_SIZE.mainWidth, 0, GUI_SIZE.mainHeight)
    main.Position = UDim2.new(1, -20, 0.5, 0)
    main.AnchorPoint = Vector2.new(1, 0.5)
    main.BackgroundColor3 = COLORS.background
    main.BorderSizePixel = 0
    addCorner(main, 12)
    main.Parent = gui

    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 50)
    titleBar.BackgroundColor3 = COLORS.panel
    titleBar.BorderSizePixel = 0
    titleBar.Parent = main
    addCorner(titleBar, 12)
    titleBar.Active = true

    local title = createTextLabel(titleBar, "🥚 Egg Tracker", 16, COLORS.accent, Enum.Font.GothamBold)
    title.Position = UDim2.fromOffset(16, 8)
    title.Size = UDim2.new(1, -120, 0, 24)

    local subtitle = createTextLabel(titleBar, "Auto-scanning for eggs", 11, COLORS.muted)
    subtitle.Position = UDim2.fromOffset(16, 26)
    subtitle.Size = UDim2.new(1, -120, 0, 16)

    -- Top buttons (Close, Minimize)
    local function createTopButton(text, xOffset)
        local btn = createTextLabel(titleBar, text, 14, COLORS.text)
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(0, 32, 0, 32)
        button.Position = UDim2.new(1, xOffset, 0.5, -16)
        button.AnchorPoint = Vector2.new(0.5, 0.5)
        button.BackgroundColor3 = COLORS.button
        button.Text = text
        button.TextColor3 = COLORS.text
        button.TextSize = 14
        button.Font = Enum.Font.GothamBold
        button.AutoButtonColor = true
        addCorner(button, 6)
        button.Parent = titleBar

        local function onHover()
            button.BackgroundColor3 = COLORS.buttonHover
        end

        local function onLeave()
            button.BackgroundColor3 = COLORS.button
        end

        button.MouseEnter:Connect(onHover)
        button.MouseLeave:Connect(onLeave)
        return button
    end

    local closeButton = createTopButton("✕", -16)
    local minimizeButton = createTopButton("−", -54)

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, 120, 1, -50)
    sidebar.Position = UDim2.new(0, 0, 0, 50)
    sidebar.BackgroundColor3 = COLORS.sidebar
    sidebar.BorderSizePixel = 0
    sidebar.Parent = main
    addPadding = function(instance, amount)
        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0, amount)
        padding.PaddingBottom = UDim.new(0, amount)
        padding.PaddingLeft = UDim.new(0, amount)
        padding.PaddingRight = UDim.new(0, amount)
        padding.Parent = instance
    end
    addPadding(sidebar, 10)

    -- Content area
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -120, 1, -50)
    content.Position = UDim2.new(0, 120, 0, 50)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.Parent = main
    addPadding(content, 16)

    -- Tabs
    local tabs = {}
    local pages = {}

    local function createPage(name)
        local page = Instance.new("Frame")
        page.Name = name .. "Page"
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.Parent = content
        pages[name] = page
        return page
    end

    local function showPage(name)
        for n, page in pairs(pages) do
            page.Visible = (n == name)
        end
        for n, tab in pairs(tabs) do
            tab.BackgroundColor3 = (n == name) and COLORS.accent or COLORS.button
            local label = tab:FindFirstChildOfClass("TextLabel")
            if label then
                label.TextColor3 = (n == name) and COLORS.background or COLORS.text
            end
        end
    end

    local function createTab(name, icon, order)
        local tab = Instance.new("TextButton")
        tab.Name = name .. "Tab"
        tab.Size = UDim2.new(1, 0, 0, 38)
        tab.LayoutOrder = order
        tab.BackgroundColor3 = COLORS.button
        tab.Text = ""
        tab.AutoButtonColor = false
        tab.Parent = sidebar

        addCorner(tab, 6)

        local tabLabel = createTextLabel(tab, icon .. " " .. name, 12, COLORS.text, Enum.Font.GothamMedium)
        tabLabel.Size = UDim2.new(1, 0, 1, 0)
        tabLabel.Position = UDim2.new(0, 0, 0, 0)
        tabLabel.TextXAlignment = Enum.TextXAlignment.Center
        tabLabel.TextYAlignment = Enum.TextYAlignment.Center

        tabs[name] = tab

        local function hover()
            if tab.BackgroundColor3 ~= COLORS.accent then
                tab.BackgroundColor3 = COLORS.buttonHover
            end
        end
        local function leave()
            if tab.BackgroundColor3 ~= COLORS.accent then
                tab.BackgroundColor3 = COLORS.button
            end
        end

        tab.MouseEnter:Connect(hover)
        tab.MouseLeave:Connect(leave)
        tab.Activated:Connect(function()
            showPage(name)
        end)
    end

    createTab("Home", "🏠", 1)
    createTab("Eggs", "🥚", 2)
    createTab("Settings", "⚙️", 3)

    -- Home Page Content
    local homePage = createPage("Home")
    local homeTitle = createTextLabel(homePage, "Welcome", 20, COLORS.accent, Enum.Font.GothamBold)
    homeTitle.Size = UDim2.new(1, 0, 0, 28)

    local homeDesc = createTextLabel(homePage, "Auto-scanning enabled\nEgg list updates every 5 seconds", 12, COLORS.muted)
    homeDesc.Position = UDim2.fromOffset(0, 35)
    homeDesc.Size = UDim2.new(1, 0, 0, 50)
    homeDesc.TextWrapped = true
    homeDesc.TextYAlignment = Enum.TextYAlignment.Top

    local statusText = createTextLabel(homePage, "Status: Ready", 11, COLORS.success)
    statusText.Position = UDim2.fromOffset(0, 95)
    statusText.Size = UDim2.new(1, 0, 0, 24)

    local eggCountHome = createTextLabel(homePage, "Eggs Found: 0", 13, COLORS.accent, Enum.Font.GothamBold)
    eggCountHome.Position = UDim2.fromOffset(0, 130)
    eggCountHome.Size = UDim2.new(1, 0, 0, 24)

    -- Eggs Page Content
    local eggsPage = createPage("Eggs")
    local eggsTitle = createTextLabel(eggsPage, "Available Eggs", 16, COLORS.accent, Enum.Font.GothamBold)
    eggsTitle.Size = UDim2.new(1, 0, 0, 28)

    local eggInfo = createTextLabel(eggsPage, "Eggs found: 0", 11, COLORS.muted)
    eggInfo.Position = UDim2.fromOffset(0, 32)
    eggInfo.Size = UDim2.new(1, 0, 0, 18)

    -- Selected Egg Display
    local selectedLabel = createTextLabel(eggsPage, "Selected Egg", 11, COLORS.text, Enum.Font.GothamMedium)
    selectedLabel.Position = UDim2.fromOffset(0, 55)
    selectedLabel.Size = UDim2.new(1, 0, 0, 16)

    local selectedEgg = createTextLabel(eggsPage, "None", 12, COLORS.accent, Enum.Font.GothamBold)
    selectedEgg.Position = UDim2.fromOffset(0, 72)
    selectedEgg.Size = UDim2.new(1, -10, 0, 20)
    selectedEgg.TextTruncate = Enum.TextTruncate.AtEnd

    -- Egg List
    local eggList = Instance.new("ScrollingFrame")
    eggList.Name = "EggList"
    eggList.Size = UDim2.new(1, 0, 0, 100)
    eggList.Position = UDim2.fromOffset(0, 100)
    eggList.BackgroundColor3 = COLORS.panel
    eggList.BorderSizePixel = 0
    eggList.ScrollBarThickness = 4
    eggList.CanvasSize = UDim2.new(0, 0, 0, 0)
    eggList.Parent = eggsPage
    addCorner(eggList, 8)

    local eggListLayout = Instance.new("UIListLayout")
    eggListLayout.Padding = UDim.new(0, 4)
    eggListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    eggListLayout.Parent = eggList

    local eggListPadding = Instance.new("UIPadding")
    eggListPadding.PaddingTop = UDim.new(0, 5)
    eggListPadding.PaddingBottom = UDim.new(0, 5)
    eggListPadding.PaddingLeft = UDim.new(0, 5)
    eggListPadding.PaddingRight = UDim.new(0, 5)
    eggListPadding.Parent = eggList

    -- Egg Detection & Logic
    local foundEggs = {}
    local currentEgg = nil
    local autoTake = false
    local autoScanEnabled = true

    -- Helper functions for egg detection
    local function getEggName(egg)
        if egg.Name ~= "" then
            return egg.Name
        end
        if egg:GetAttribute("DisplayName") then
            return egg:GetAttribute("DisplayName")
        end
        local part = egg:FindFirstChild("Part")
        if part and part.Name ~= "" then
            return part.Name
        end
        return egg.Name or "Unknown Egg"
    end

    local function isEgg(object)
        if not object or not object.Parent then return false end
        if object:GetAttribute("IsEgg") then return true end
        if string.find(string.lower(object.Name), "egg", 1, true) then return true end
        return false
    end

    local function findEggs()
        table.clear(foundEggs)
        local success, result = pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and isEgg(obj) then
                    table.insert(foundEggs, obj)
                end
            end
        end)
        if not success then
            warn("Error finding eggs: "..tostring(result))
        end
        table.sort(foundEggs, function(a, b)
            return getEggName(a):lower() < getEggName(b):lower()
        end)
        return foundEggs
    end

    local function clearEggList()
        for _, child in ipairs(eggList:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
    end

    local function createEggButton(egg, index)
        local button = Instance.new("TextButton")
        button.Size = GUI_SIZE.eggButtonSize
        button.LayoutOrder = index
        button.BackgroundColor3 = COLORS.button
        button.Text = getEggName(egg)
        button.TextColor3 = COLORS.text
        button.TextSize = 11
        button.Font = Enum.Font.GothamMedium
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.AutoButtonColor = false
        button.Parent = eggList
        addCorner(button, 5)

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 8)
        padding.Parent = button

        local function hover()
            button.BackgroundColor3 = COLORS.buttonHover
        end
        local function leave()
            button.BackgroundColor3 = COLORS.button
        end

        button.MouseEnter:Connect(hover)
        button.MouseLeave:Connect(leave)

        button.Activated:Connect(function()
            if egg and egg.Parent then
                currentEgg = egg
                selectedEgg.Text = "🎯 " .. getEggName(egg)
                -- Update status
                local status = player.PlayerGui:FindFirstChild("MyControlPanel"):FindFirstChild("StatusText")
                if status then
                    status.Text = "Selected: " .. getEggName(egg)
                    status.TextColor3 = COLORS.success
                end
            else
                warn("Egg no longer exists")
            end
        end)
        return button
    end

    local function refreshEggs()
        clearEggList()
        findEggs()
        local count = #foundEggs
        -- Update egg counts
        local status = player.PlayerGui:FindFirstChild("MyControlPanel"):FindFirstChild("StatusText")
        if status then
            status.Text = "Eggs found: " .. count
            status.TextColor3 = count > 0 and COLORS.success or COLORS.danger
        end

        for i, egg in ipairs(foundEggs) do
            if egg and egg.Parent then
                createEggButton(egg, i)
            end
        end
        -- Adjust canvas size
        eggList.CanvasSize = UDim2.new(0, 0, 0, eggListLayout.AbsoluteContentSize.Y + 10)
    end

    local function takeEgg(egg)
        if not egg or not egg.Parent then
            local status = player.PlayerGui:FindFirstChild("MyControlPanel"):FindFirstChild("StatusText")
            if status then
                status.Text = "Egg no longer exists"
                status.TextColor3 = COLORS.danger
            end
            return false
        end
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            egg.Parent = player.Backpack or player
            local status = player.PlayerGui:FindFirstChild("MyControlPanel"):FindFirstChild("StatusText")
            if status then
                status.Text = "Took: " .. getEggName(egg)
                status.TextColor3 = COLORS.success
            end
            return true
        else
            local status = player.PlayerGui:FindFirstChild("MyControlPanel"):FindFirstChild("StatusText")
            if status then
                status.Text = "Character not found"
                status.TextColor3 = COLORS.danger
            end
            return false
        end
    end

    -- Auto Take Button
    local autoTakeBtn = createButton(eggsPage, "🤖 Auto Take: OFF", GUI_SIZE.autoTakeSize, UDim2.new(0, 0, 0, 210), COLORS.button, COLORS.muted)
    addCorner(autoTakeBtn, 6)

    local autoTakeActive = false

    local function updateAutoTakeButton()
        autoTakeBtn.Text = "🤖 Auto Take: " .. (autoTakeActive and "ON" or "OFF")
        autoTakeBtn.BackgroundColor3 = autoTakeActive and COLORS.accent or COLORS.button
        autoTakeBtn.TextColor3 = autoTakeActive and COLORS.background or COLORS.muted
    end

    autoTakeBtn.MouseEnter:Connect(function()
        autoTakeBtn.BackgroundColor3 = COLORS.buttonHover
    end)
    autoTakeBtn.MouseLeave:Connect(function()
        updateAutoTakeButton()
    end)
    autoTakeBtn.Activated:Connect(function()
        autoTakeActive = not autoTakeActive
        updateAutoTakeButton()
        if autoTakeActive and currentEgg and currentEgg.Parent then
            takeEgg(currentEgg)
        end
    end)

    -- Settings Page
    local settingsPage = createPage("Settings")
    local settingsTitle = createTextLabel(settingsPage, "Settings", 16, COLORS.accent, Enum.Font.GothamBold)
    settingsTitle.Size = UDim2.new(1, 0, 0, 28)

    local toggleLabel = createTextLabel(settingsPage, "Auto Scan Every 5s", 12, COLORS.text)
    toggleLabel.Position = UDim2.fromOffset(0, 40)
    toggleLabel.Size = UDim2.new(1, -70, 0, 28)

    local autoScanToggle = createButton(settingsPage, "ON", GUI_SIZE.toggleSize, UDim2.new(1, -68, 0, 40), COLORS.accent, COLORS.background)
    addCorner(autoScanToggle, 6)

    local autoScanEnabled = true

    local function updateToggle()
        autoScanToggle.Text = autoScanEnabled and "ON" or "OFF"
        autoScanToggle.BackgroundColor3 = autoScanEnabled and COLORS.accent or COLORS.button
        autoScanToggle.TextColor3 = autoScanEnabled and COLORS.background or COLORS.text
    end

    autoScanToggle.MouseEnter:Connect(function()
        autoScanToggle.BackgroundColor3 = COLORS.accentDark
    end)
    autoScanToggle.MouseLeave:Connect(function()
        updateToggle()
    end)
    autoScanToggle.Activated:Connect(function()
        autoScanEnabled = not autoScanEnabled
        updateToggle()
    end)

    -- Minimize Button functionality
    local minimized = false
    local function setMinimized(value)
        minimized = value
        sidebar.Visible = not minimized
        content.Visible = not minimized
        main.Size = minimized and UDim2.new(0, GUI_SIZE.mainWidth, 0, 50)
            or UDim2.new(0, GUI_SIZE.mainWidth, 0, GUI_SIZE.mainHeight)
    end

    minimizeButton.Activated:Connect(function()
        setMinimized(not minimized)
    end)

    -- Close Button
    closeButton.Activated:Connect(function()
        gui:Destroy()
    end)

    -- Dragging the GUI
    local dragging = false
    local dragStart, startPos

    titleBar.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(0, startPos.X.Offset + delta.X, 0, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Auto scan loop
    task.spawn(function()
        while gui.Parent do
            if autoScanEnabled then
                refreshEggs()
                task.wait(5)
            else
                task.wait(1)
            end
        end
    end)

    -- Initialize display
    showPage("Eggs")
    refreshEggs()

    -- Auto Egg Collection Loop
    task.spawn(function()
        while gui.Parent do
            if autoTake and currentEgg and currentEgg.Parent then
                takeEgg(currentEgg)
            end
            task.wait(5) -- or your preferred interval
        end
    end)
end

-- Floating button to toggle control panel
local loaderGui = playerGui:FindFirstChild("ControlPanelLoader")
if loaderGui then loaderGui:Destroy() end

loaderGui = Instance.new("ScreenGui")
loaderGui.Name = "ControlPanelLoader"
loaderGui.ResetOnSpawn = false
loaderGui.Parent = playerGui

local openButton = createButton(loaderGui, "🥚", UDim2.new(0, 50, 0, 50), UDim2.new(0.5, -25, 0.5, -25), Color3.fromRGB(100, 150, 255), Color3.fromRGB(245, 248, 255))
addCorner(openButton, 12)

local buttonStroke = Instance.new("UIStroke")
buttonStroke.Color = Color3.fromRGB(100, 150, 255)
buttonStroke.Thickness = 2
buttonStroke.Transparency = 0.3
buttonStroke.Parent = openButton

-- Drag functionality for the floating button
local dragging = false
local dragStart, startPos

openButton.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = openButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        openButton.Position = UDim2.new(0, startPos.X.Offset + delta.X, 0, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Hover effect
openButton.MouseEnter:Connect(function()
    openButton.BackgroundColor3 = Color3.fromRGB(120, 170, 255)
    openButton.Size = UDim2.fromOffset(56, 56)
end)
openButton.MouseLeave:Connect(function()
    openButton.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    openButton.Size = UDim2.fromOffset(50, 50)
end)

-- Toggle control panel
openButton.Activated:Connect(function()
    local existingGui = playerGui:FindFirstChild("MyControlPanel")
    if existingGui then
        existingGui:Destroy()
    else
        loadControlPanel()
    end
end)
