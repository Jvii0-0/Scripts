	--------------------------------------------------
	-- TAKE EGG
	--------------------------------------------------

	local function takeEgg(egg)

		if not egg or not egg.Parent then

			status.Text = "Egg no longer exists"
			status.TextColor3 = colors.danger

			return false

		end

		local humanoidRootPart =
			player.Character
			and player.Character:FindFirstChild("HumanoidRootPart")

		if humanoidRootPart then

			egg.Parent = player.Backpack or player

			status.Text = "Took: " .. getEggName(egg)
			status.TextColor3 = colors.success

			return true

		else

			status.Text = "Character not found"
			status.TextColor3 = colors.danger

			return false

		end

	end

	--------------------------------------------------
	-- AUTO SCAN TOGGLE
	--------------------------------------------------

	local toggle = Instance.new("TextButton")

	toggle.Size = UDim2.new(1, 0, 0, 32)
	toggle.Position = UDim2.fromOffset(0, 290)
	toggle.BackgroundColor3 = colors.accent
	toggle.Text = "ON"
	toggle.TextColor3 = colors.background
	toggle.TextSize = 11
	toggle.Font = Enum.Font.GothamBold
	toggle.BorderSizePixel = 0
	toggle.ZIndex = 1003

	toggle.Parent = eggsPage

	addCorner(toggle, 6)

	toggle.MouseEnter:Connect(function()

		toggle.BackgroundColor3 = colors.accentDark

	end)

	toggle.MouseLeave:Connect(function()

		if autoScanEnabled then

			toggle.BackgroundColor3 = colors.accent

		else

			toggle.BackgroundColor3 = colors.button

		end

	end)

	toggle.Activated:Connect(function()

		autoScanEnabled = not autoScanEnabled

		toggle.Text = autoScanEnabled and "ON" or "OFF"

		toggle.BackgroundColor3 =
			autoScanEnabled
			and colors.accent
			or colors.button

		toggle.TextColor3 =
			autoScanEnabled
			and colors.background
			or colors.text

	end)

	--------------------------------------------------
	-- SETTINGS PAGE
	--------------------------------------------------

	local settingsPage = createPage("Settings")

	local settingsTitle = createText(
		settingsPage,
		"Settings",
		16,
		colors.accent,
		Enum.Font.GothamBold
	)

	settingsTitle.Size = UDim2.new(1, 0, 0, 28)
	settingsTitle.ZIndex = 1003

	local settingsInfo = createText(
		settingsPage,
		"Egg scanning refreshes automatically.",
		11,
		colors.muted
	)

	settingsInfo.Position = UDim2.fromOffset(0, 35)
	settingsInfo.Size = UDim2.new(1, 0, 0, 40)
	settingsInfo.TextWrapped = true
	settingsInfo.ZIndex = 1003

	--------------------------------------------------
	-- PAGE BUTTONS
	--------------------------------------------------

	homeButton.Activated:Connect(function()
		showPage("Home")
	end)

	eggsButton.Activated:Connect(function()
		showPage("Eggs")
	end)

	settingsButton.Activated:Connect(function()
		showPage("Settings")
	end)

	--------------------------------------------------
	-- MINIMIZE
	--------------------------------------------------

	local minimized = false

	local function setMinimized(value)

		minimized = value

		sidebar.Visible = not minimized
		content.Visible = not minimized

		main.Size =
			minimized
			and UDim2.fromOffset(500, 50)
			or UDim2.fromOffset(500, 350)

	end

	minimizeButton.Activated:Connect(function()

		setMinimized(not minimized)

	end)

	--------------------------------------------------
	-- CLOSE
	--------------------------------------------------

	closeButton.Activated:Connect(function()

		gui:Destroy()

	end)

	--------------------------------------------------
	-- TITLE BAR DRAG FUNCTIONALITY
	--------------------------------------------------

	local dragging = false
	local dragStart = nil
	local startPos = nil

	titleBar.InputBegan:Connect(function(input, gameProcessed)

		if gameProcessed then
			return
		end

		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then

			dragging = true

			dragStart = input.Position
			startPos = main.Position

		end

	end)

	UserInputService.InputChanged:Connect(function(input, gameProcessed)

		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then

			if dragStart then

				local delta =
					input.Position - dragStart

				main.Position = UDim2.fromOffset(
					startPos.X.Offset + delta.X,
					startPos.Y.Offset + delta.Y
				)

			end

		end

	end)

	UserInputService.InputEnded:Connect(function(input, gameProcessed)

		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then

			dragging = false

		end

	end)

	--------------------------------------------------
	-- AUTO SCAN LOOP
	--------------------------------------------------

	task.spawn(function()

		while gui.Parent do

			if autoScanEnabled then

				refreshEggs()

				task.wait(5)

			else

				task.wait(1)

			end

		end

	end)

	--------------------------------------------------
	-- INITIALIZE
	--------------------------------------------------

	showPage("Eggs")

	refreshEggs()

end

