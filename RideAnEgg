				status.TextColor3 = colors.success
			else
				status.Text = "Egg no longer exists"
				status.TextColor3 = colors.danger
				currentEgg = nil
			end
		end)

		return button
	end

	--------------------------------------------------
	-- REFRESH EGG LIST
	--------------------------------------------------

	local function refreshEggs()
		clearEggList()
		findEggs()

		eggInfo.Text = "Eggs found: " .. tostring(#foundEggs)
		eggCountHome.Text = "Eggs Found: " .. tostring(#foundEggs)

		if #foundEggs > 0 then
			eggInfo.TextColor3 = colors.success
			eggCountHome.TextColor3 = colors.success
		else
			eggInfo.TextColor3 = colors.danger
			eggCountHome.TextColor3 = colors.danger
		end

		for index, egg in ipairs(foundEggs) do
			if egg and egg.Parent then
				createEggButton(egg, index)
			end
		end

		task.wait()

		eggList.CanvasSize = UDim2.new(
			0,
			0,
			0,
			eggListLayout.AbsoluteContentSize.Y + 10
		)
	end

	--------------------------------------------------
	-- TAKE EGG FUNCTION
	--------------------------------------------------

	local function takeEgg(egg)
		if not egg or not egg.Parent then
			status.Text = "Egg no longer exists"
			status.TextColor3 = colors.danger
			return false
		end

		local humanoidRootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		
		if humanoidRootPart then
			egg.Parent = player.Backpack or player
			status.Text = "Took: " .. getEggName(egg)
			status.TextColor3 = colors.success
			return true
		else
			status.Text = "Character not found"
			status.TextColor3 = colors.danger
			return false
		end
	end

