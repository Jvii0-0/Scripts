	--------------------------------------------------
	-- EGG NAME
	--------------------------------------------------

	local function getEggName(object)

		if object.Name and object.Name ~= "" then
			return object.Name
		end

		if object:GetAttribute("DisplayName") then
			return object:GetAttribute("DisplayName")
		end

		local part = object:FindFirstChild("Part")

		if part and part.Name ~= "" then
			return part.Name
		end

		return object.Name or "Unknown Egg"

	end

	--------------------------------------------------
	-- EGG CHECK
	--------------------------------------------------

	local function isEgg(object)

		if not object or not object.Parent then
			return false
		end

		if object:GetAttribute("IsEgg") == true then
			return true
		end

		if string.find(string.lower(object.Name), "egg", 1, true) then
			return true
		end

		return false

	end

	--------------------------------------------------
	-- FIND EGGS
	--------------------------------------------------

	local function findEggs()

		table.clear(foundEggs)

		local success, result = pcall(function()

			for _, object in ipairs(workspace:GetDescendants()) do

				if object:IsA("Model") and isEgg(object) then
					table.insert(foundEggs, object)
				end

			end

		end)

		if not success then
			warn("Egg scan failed:", result)
			return foundEggs
		end

		table.sort(foundEggs, function(a, b)

			if not a.Parent or not b.Parent then
				return false
			end

			return string.lower(getEggName(a)) < string.lower(getEggName(b))

		end)

		return foundEggs

	end

	--------------------------------------------------
	-- EGG POSITION
	--------------------------------------------------

	local function getEggPosition(egg)

		if not egg or not egg.Parent then
			return nil
		end

		if egg:IsA("BasePart") then
			return egg.Position
		end

		if egg:IsA("Model") then

			if egg.PrimaryPart then
				return egg.PrimaryPart.Position
			end

			local part = egg:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

			if part then
				return part.Position
			end

		end

		return nil

	end

	--------------------------------------------------
	-- STOP MOVEMENT
	--------------------------------------------------

	local function stopGoingToEgg()

		movementToken += 1

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid:Move(Vector3.zero)
		end

	end

	--------------------------------------------------
	-- GO TO EGG
	--------------------------------------------------

	local function goToEgg(egg)

		if not egg or not egg.Parent then
			status.Text = "Egg no longer exists"
			status.TextColor3 = colors.danger
			return
		end

		local character = player.Character

		if not character then
			status.Text = "Character not found"
			status.TextColor3 = colors.danger
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")

		if not humanoid or not root then
			status.Text = "Character not ready"
			status.TextColor3 = colors.danger
			return
		end

		local targetPosition = getEggPosition(egg)

		if not targetPosition then
			status.Text = "Egg position not found"
			status.TextColor3 = colors.danger
			return
		end

		local myToken = movementToken

		status.Text = "Going to: " .. getEggName(egg)
		status.TextColor3 = colors.accent

		local success, path = pcall(function()

			local newPath = PathfindingService:CreatePath({
				AgentRadius = 2,
				AgentHeight = 5,
				AgentCanJump = true,
				AgentCanClimb = true
			})

			newPath:ComputeAsync(
				root.Position,
				targetPosition
			)

			return newPath

		end)

		if success and path and path.Status == Enum.PathStatus.Success then

			local waypoints = path:GetWaypoints()

			for _, waypoint in ipairs(waypoints) do

				if myToken ~= movementToken then
					return
				end

				if not egg.Parent then
					status.Text = "Egg disappeared"
					status.TextColor3 = colors.danger
					return
				end

				if waypoint.Action == Enum.PathWaypointAction.Jump then
					humanoid.Jump = true
				end

				humanoid:MoveTo(waypoint.Position)

				local reached = humanoid.MoveToFinished:Wait()

				if not reached then
					break
				end

			end

			if myToken == movementToken then
				status.Text = "Reached: " .. getEggName(egg)
				status.TextColor3 = colors.success
			end

		else

			humanoid:MoveTo(targetPosition)

			local reached = humanoid.MoveToFinished:Wait()

			if myToken ~= movementToken then
				return
			end

			if reached then
				status.Text = "Reached: " .. getEggName(egg)
				status.TextColor3 = colors.success
			else
				status.Text = "Could not reach egg"
				status.TextColor3 = colors.danger
			end

		end

	end

