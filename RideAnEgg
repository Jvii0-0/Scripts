local function refreshEggs()

	clearEggList()

	findEggs()

	eggInfo.Text = "Eggs found: " .. tostring(#foundEggs)

	for index, egg in ipairs(foundEggs) do

		createEggButton(egg, index)

	end

	task.wait()

	eggList.CanvasSize = UDim2.new(
		0,
		0,
		0,
		eggListLayout.AbsoluteContentSize.Y + 14
	)

	if #foundEggs > 0 then

		status.Text =
			"Status: Found "
			.. tostring(#foundEggs)
			.. " eggs"

	else

		status.Text = "Status: No eggs found"

	end
end

