	local function inspectSelectedEgg()

		if not currentEgg or not currentEgg.Parent then

			print("========== EGG INSPECTION ==========")
			print("No egg is currently selected.")
			print("====================================")

			return

		end

		local egg = currentEgg

		print("")
		print("========== EGG INSPECTION ==========")

		print("Name:", egg.Name)
		print("Class:", egg.ClassName)
		print("Full Path:", egg:GetFullName())
		print("Parent:", egg.Parent and egg.Parent:GetFullName() or "None")

		print("")
		print("----- ATTRIBUTES -----")

		local attributes = egg:GetAttributes()

		if next(attributes) == nil then

			print("No attributes found.")

		else

			for name, value in pairs(attributes) do

				local lowerName = string.lower(name)

				local possibleOwnership =
					string.find(lowerName, "owner", 1, true)
					or string.find(lowerName, "user", 1, true)
					or string.find(lowerName, "player", 1, true)
					or string.find(lowerName, "claim", 1, true)
					or string.find(lowerName, "belong", 1, true)
					or string.find(lowerName, "own", 1, true)

				if possibleOwnership then

					print(
						"[POSSIBLE OWNERSHIP FIELD]",
						name,
						"=",
						value
					)

				else

					print(
						name,
						"=",
						value
					)

				end

			end

		end

		print("")
		print("----- DIRECT CHILDREN -----")

		for _, child in ipairs(egg:GetChildren()) do

			print(
				child.Name,
				"|",
				child.ClassName
			)

			if child:IsA("ValueBase") then

				print(
					"   VALUE:",
					child.Value
				)

			end

		end

		print("")
		print("----- ALL DESCENDANTS -----")

		for _, descendant in ipairs(egg:GetDescendants()) do

			print(
				descendant:GetFullName(),
				"|",
				descendant.ClassName
			)

			if descendant:IsA("ValueBase") then

				print(
					"   VALUE:",
					descendant.Value
				)

			end

		end

		print("")
		print("----- COMMON OWNERSHIP FIELDS -----")

		local commonNames = {
			"Owner",
			"OwnerId",
			"OwnerUserId",
			"UserId",
			"Player",
			"PlayerId",
			"Claimed",
			"ClaimedBy",
			"Owned",
			"IsOwned",
			"IsClaimed",
			"BelongsTo"
		}

		for _, name in ipairs(commonNames) do

			local attribute = egg:GetAttribute(name)

			if attribute ~= nil then

				print(
					"ATTRIBUTE",
					name,
					"=",
					attribute
				)

			end

			local child = egg:FindFirstChild(name, true)

			if child then

				print(
					"OBJECT",
					name,
					"=",
					child.ClassName
				)

				if child:IsA("ValueBase") then

					print(
						"VALUE:",
						child.Value
					)

				end

			end

		end

		print("====================================")
		print("")

	end

